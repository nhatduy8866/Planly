# Supabase cho sao lưu, đồng bộ và Gemini proxy bảo mật
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Bắt buộc trước khi tạo bản release công khai
EXPO_PUBLIC_DATA_CONTROLLER_NAME=your_legal_name_or_company_here
EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=your_privacy_contact_email_here
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacy
EXPO_PUBLIC_ACCOUNT_DELETION_URL=https://your-domain.example/delete-account
