# Google Gemini API Key cho tính năng Planly AI
# Bạn có thể lấy key miễn phí tại: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase cho sao lưu và đồng bộ task/note giữa các thiết bị
EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
