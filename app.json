{
  "expo": {
    "name": "Planly",
    "slug": "planly",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "planly",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "androidStatusBar": {
      "backgroundColor": "#FAF7F0",
      "barStyle": "dark-content",
      "translucent": false
    },
    "ios": {
      "bundleIdentifier": "com.planly.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.planly.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#4F46E5",
          "defaultChannel": "planly-reminders-v3",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      [
        "./plugins/withAlarmScheduler",
        {
          "addExactAlarmPermission": false,
          "addUseExactAlarmPermission": true,
          "alarmKitUsageDescription": "Cho phép Planly đặt báo thức cho công việc của bạn.",
          "androidAlarmSounds": [
            "./assets/alarm/sounds/planly_classic.wav",
            "./assets/alarm/sounds/planly_sunrise.wav",
            "./assets/alarm/sounds/planly_gentle.wav",
            "./assets/alarm/sounds/planly_pulse.wav",
            "./assets/alarm/sounds/planly_digital.wav"
          ],
          "iosAlarmSounds": [
            "./assets/alarm/sounds/planly_classic.wav",
            "./assets/alarm/sounds/planly_sunrise.wav",
            "./assets/alarm/sounds/planly_gentle.wav",
            "./assets/alarm/sounds/planly_pulse.wav",
            "./assets/alarm/sounds/planly_digital.wav"
          ]
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F0"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "PlanlyToday",
              "displayName": "Planly Hôm nay",
              "description": "Xem nhanh các công việc hôm nay.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "contentMarginsDisabled": true,
              "android": null
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PlanlyToday",
              "label": "Planly Hôm nay",
              "description": "Xem nhanh các công việc hôm nay.",
              "minWidth": "250dp",
              "minHeight": "60dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "./plugins/withReleaseSecurity"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
